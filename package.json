{
  "name": "opencode-feishu-v2",
  "version": "0.1.0",
  "description": "OpenCode V2 飞书插件 — 长连接单聊接入 + 卡片按钮审批 (最小权限, p2p only)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "feishu",
    "lark",
    "飞书",
    "飞书机器人"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.74.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.0.16"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.16",
    "@types/node": "^20.19.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
