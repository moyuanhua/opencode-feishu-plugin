{
  "name": "opencode-feishu-plugin",
  "version": "0.2.16",
  "description": "Feishu/Lark plugin for OpenCode V2 — single-user topics as sessions, in-card permission approvals, streaming cards. Minimal permissions, no public endpoint.",
  "type": "module",
  "main": "index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "index.js",
    "dist/index.js",
    "dist/index.d.ts",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node -e \"require('fs').existsSync('node_modules')||require('child_process').execSync('npm ci --no-audit --no-fund',{stdio:'inherit'})\" && npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "feishu",
    "lark",
    "飞书",
    "飞书机器人",
    "lark-bot",
    "ai-agent",
    "coding-agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyuanhua/opencode-feishu-plugin.git"
  },
  "homepage": "https://github.com/moyuanhua/opencode-feishu-plugin#readme",
  "bugs": {
    "url": "https://github.com/moyuanhua/opencode-feishu-plugin/issues"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.74.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.16"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.16",
    "@types/node": "^20.19.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
